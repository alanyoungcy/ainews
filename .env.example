# OpenAI-compatible provider used for Capco editorial synthesis and artwork.
# Without this key, the workspace still creates a grounded local draft from TrendRadar.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1

# TrendRadar editorial language filter. Set to "all" to include every source.
TREND_RADAR_LANGUAGE=en

# Optional: point the workspace at another OpenAI-compatible gateway.
AI_API_BASE=https://api.openai.com/v1
